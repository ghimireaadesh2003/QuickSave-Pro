{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/quickSavePro.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": {
            "mimeType": "text/*"
          }
        }
      ],
      "package": "com.anonymous.first",
      "plugins": [
        [
          "expo-share-intent",
          {
            "androidIntentFilters": ["text/*"]
          }
        ]
      ],
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "36c45d62-0bc6-4a66-8982-23082d62078c"
      },
      "router": {}
    },
    "icon": "./assets/images/quickSavePro.png",
    "ios": {
      "bundleIdentifier": "com.anonymous.first",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "name": "QuickSave Pro",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          },
          "image": "./assets/images/quickSavePro.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-share-intent"
    ],
    "scheme": "first",
    "slug": "first",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    }
  }
}
